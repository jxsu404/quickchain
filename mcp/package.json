{
  "name": "quickpass-mcp",
  "version": "0.1.0",
  "description": "MCP server de Stellar QuickPass: el agente paga APIs x402 desde una cuenta-presupuesto con tope (Stellar testnet).",
  "private": true,
  "type": "module",
  "bin": { "quickpass-mcp": "dist/index.js" },
  "engines": { "node": ">=20" },
